<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Edit User</title>
</head>
<body>
  <h1>Edit User</h1>
  <form action="/users/<%= user._id %>/update" method="post">
    <label>First name: <input type="text" name="firstName" value="<%= user.firstName %>" required></label><br>
    <label>Last name: <input type="text" name="lastName" value="<%= user.lastName %>" required></label><br>
    <label>Email: <input type="email" name="email" value="<%= user.email %>" required></label><br>
    <label>Address: <input type="text" name="address" value="<%= user.address %>"></label><br>
    <button type="submit">Save</button>
  </form>
  <p><a href="/users">Back to list</a></p>
</body>
</html>
